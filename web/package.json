{
  "name": "sector-flow-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-data.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-data.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "verify": "npm run verify:logic && npm run verify:render",
    "verify:logic": "esbuild scripts/verify.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/verify.mjs --log-level=error --define:import.meta.env={} && node node_modules/.tmp/verify.mjs ../data",
    "verify:render": "esbuild scripts/render-check.tsx --bundle --platform=node --format=cjs --jsx=automatic --outfile=node_modules/.tmp/render.cjs --log-level=error --define:import.meta.env={} && node node_modules/.tmp/render.cjs ../data"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
